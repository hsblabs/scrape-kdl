{
  "name": "@hsblabs/scrape-kdl",
  "version": "0.0.0-development",
  "description": "TypeScript compiler and runtime for the Scraping KDL language",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring.d.ts",
      "import": "./dist/authoring.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsblabs/scrape-kdl.git",
    "directory": "packages/scrape-kdl"
  },
  "bugs": {
    "url": "https://github.com/hsblabs/scrape-kdl/issues"
  },
  "homepage": "https://github.com/hsblabs/scrape-kdl#readme",
  "publishConfig": {
    "access": "restricted"
  },
  "dependencies": {
    "parse5": "8.0.1",
    "re2js": "2.8.6"
  }
}
