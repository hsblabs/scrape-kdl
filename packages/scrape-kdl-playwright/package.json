{
  "name": "@hsblabs/scrape-kdl-playwright",
  "version": "0.0.0-development",
  "description": "Official Playwright adapter for @hsblabs/scrape-kdl",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:e2e": "node --test test/e2e.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsblabs/scrape-kdl.git",
    "directory": "packages/scrape-kdl-playwright"
  },
  "bugs": {
    "url": "https://github.com/hsblabs/scrape-kdl/issues"
  },
  "homepage": "https://github.com/hsblabs/scrape-kdl#readme",
  "publishConfig": {
    "access": "restricted"
  },
  "devDependencies": {
    "@hsblabs/scrape-kdl": "0.0.0-development"
  },
  "peerDependencies": {
    "@hsblabs/scrape-kdl": "0.0.0-development || ^1.0.0"
  },
  "dependencies": {
    "playwright": "1.61.1"
  }
}
