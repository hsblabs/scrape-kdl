extractor "regex-lookahead" version="2026-07-15" language-version="2026-07-15" {
  source "html" {
    fetch mode="http" url="https://example.invalid/"
  }

  field "value" type="string" required=#true {
    select "body" match="one"
    value "text"
    apply "assert-matches" pattern="a(?=b)"
  }
}
