{
  "name": "scrape-kdl-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "conformance:typescript": "npm run build:typescript && node packages/scrape-kdl/test/manifest-runner.mjs",
    "coverage:typescript": "npm run build:typescript && node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-branches=60 --test-coverage-functions=80 packages/scrape-kdl/test/*.test.mjs",
    "examples:typescript": "npm run build:typescript && node scripts/check-examples.mjs",
    "format:typescript": "prettier --write \"packages/*/src/**/*.ts\" \"scripts/*.mjs\"",
    "format:typescript:check": "prettier --check \"packages/*/src/**/*.ts\" \"scripts/*.mjs\"",
    "lint:typescript": "node scripts/lint-typescript.mjs",
    "package:check": "npm run build:typescript && node scripts/check-npm-package.mjs",
    "test:typescript-contract": "npm run build:typescript && node packages/scrape-kdl/test/contract.test.mjs",
    "test:typescript": "npm run build:typescript && node --test packages/scrape-kdl/test/*.test.mjs",
    "typecheck:api": "npm run build:typescript && tsc --project testdata/api-consumers/typescript/tsconfig.json",
    "typecheck:typescript": "npm run typecheck --workspaces --if-present",
    "verify:typescript": "npm run typecheck:typescript && npm run format:typescript:check && npm run lint:typescript && npm run test:typescript && npm run coverage:typescript && npm run package:check",
    "build:typescript": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "prettier": "3.9.4",
    "typescript": "7.0.2"
  }
}
