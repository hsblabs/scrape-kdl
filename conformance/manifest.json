      "artifacts": [
        "fixtures/parser/cases.json",
        "fixtures/parser/fuzz-seeds.json",
        "fixtures/parser/invalid-utf8.json",
        "fixtures/imports/cases.json"
      ]
    },
    {
      "id": "html-compatibility-2026-07-15",
      "purpose": "Pinned cross-runtime charset, HTML tree-construction, serialization, portable-selector, and WPT observations; the tree inventory also feeds the Chromium differential gate.",
