{
  "$schema": "./manifest.schema.json",
  "schemaVersion": "2026-07-15",
  "contract": {
    "languageVersion": "2026-07-15",
    "irVersion": "2026-07-15"
  },
  "normalization": {
    "paths": "repository-relative-forward-slash",
    "sourceBytes": "exact-no-newline-normalization",
    "json": "canonical-unicode-code-point-order-finite-binary64",
    "diagnostics": "exact-code-severity-message-span-path-order",
    "spans": "utf8-byte-offset-one-based-line-column-exclusive-end"
  },
  "suites": {
    "pr": { "description": "Release-blocking cases executed by pull-request jobs." },
    "release": { "description": "Every release-blocking case across core and browser jobs." },
    "language": { "description": "Parser, compiler, diagnostic, and IR language cases." },
    "invalid": { "description": "Shared rejected-program diagnostic cases." },
    "ir": { "description": "Canonical Validated IR comparisons." },
    "runtime": { "description": "Offline extraction comparisons." },
    "html": { "description": "Pinned HTML input and observation cases." },
    "browser": { "description": "Browser-contract and official-adapter cases." },
    "typescript-slice": { "description": "The bounded TypeScript pre-freeze cross-check." }
  },
  "approvedDivergences": [],
  "cases": [
    {
      "id": "valid.basic-http",
      "status": "release-blocking",
      "categories": ["valid", "ir", "runtime", "html"],
      "suites": ["pr", "release", "language", "ir", "runtime", "html", "typescript-slice"],
      "artifacts": [
        { "path": "fixtures/valid/basic-http.kdl", "role": "source" },
        { "path": "fixtures/expected-ir/basic-http.ir.json", "role": "expected-ir" },
        { "path": "fixtures/inputs/basic-http.json", "role": "inputs" },
        { "path": "fixtures/html/basic-http.html", "role": "html" },
        { "path": "fixtures/expected-output/basic-http.json", "role": "expected-output" }
      ],
      "expectations": {
        "outcome": "valid",
        "ir": "fixtures/expected-ir/basic-http.ir.json",
        "html": "fixtures/html/basic-http.html",
        "inputs": "fixtures/inputs/basic-http.json",
        "output": "fixtures/expected-output/basic-http.json"
      },
      "executions": [
        { "implementation": "go", "job": "core", "stages": ["validate", "compile", "ir", "runtime"] },
        { "implementation": "typescript", "job": "core", "stages": ["validate", "compile", "ir"] }
      ]
    },
    {
